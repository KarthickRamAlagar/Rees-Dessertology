# --- Frontend (exposed to the browser, must start with VITE_) ---
# Firebase client SDK config — from your Firebase project's web app
# settings. Used ONLY for Firebase Authentication (Google sign-in,
# src/lib/firebase.js); every data read/write goes through client/api/** on
# the Admin SDK with the signed-in user's ID token.
#
# REQUIRED one-time setup in the Firebase Console:
#   - Authentication -> Sign-in method -> enable the "Google" provider.
#   - Authentication -> Settings -> Authorized domains -> make sure
#     "localhost" (dev) and your production domain are listed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Leave VITE_API_URL unset in production (same-origin). Only set it for local
# dev if you run `vercel dev` on a different port than the one your browser
# opens, e.g. VITE_API_URL=http://localhost:3000
VITE_API_URL=

# --- Backend (server-side only, used by client/api/** serverless functions) ---
# Firebase Admin SDK credentials — pick ONE of these three, checked in this
# order (client/api/_lib.js):
#   1. FIREBASE_SERVICE_ACCOUNT_PATH — path to the downloaded key file.
#      e.g. on Windows: D:\keys\rees-dessertology\serviceAccountKey.json
#      The key file itself stays on disk outside the repo; only its path
#      goes here. This is the one to use for local dev on your machine.
#   2. FIREBASE_SERVICE_ACCOUNT_JSON — the whole key file's contents pasted
#      in as one single-line JSON string (handy for Vercel env vars, where
#      there's no local filesystem to point a path at).
#   3. FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY —
#      the same three fields pulled out of that JSON file individually.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Storage bucket name (e.g. your-project.appspot.com) — used for
# admin product-photo uploads and Unsplash-fetched images.
FIREBASE_STORAGE_BUCKET=

# While true, every new order's grand total is forced to ₹1 (real cart
# math still gets saved to subtotal/deliveryFee for the record) so you can
# run a real UPI payment through your actual QR code end to end without
# spending the real amount. Set to false (or remove the line) before going
# live so customers are charged the real total.
TEST_MODE=false

# Admin access (server-side only). Comma-separated Google account emails,
# case-insensitive. Anyone who signs in with Google using one of these emails
# is an admin (dashboard + every /api/admin/* route, checked in
# requireAdmin() in client/api/_lib.js). Example: ADMIN_EMAILS=owner@gmail.com,helper@gmail.com
ADMIN_EMAILS=

UNSPLASH_ACCESS_KEY=your_unsplash_access_key
CLIENT_ORIGIN=http://localhost:5173

# Razorpay (not wired into checkout yet — kept here for when it is)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
